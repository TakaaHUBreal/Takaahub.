    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 6, 0, 6)
    circle.Position = UDim2.new(0, 2, 0.5, -3)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.Parent = toggleBtn
    
    local cc = Instance.new("UICorner")
    cc.CornerRadius = UDim.new(1, 0)
    cc.Parent = circle
    
    local state = false
    toggleBtn.MouseButton1Click:Connect(function()
        playClickSound()
        state = not state
        toggleBtn.BackgroundColor3 = state and Color3.fromRGB(220, 30, 30) or Color3.fromRGB(40, 40, 40)
        circle.Position = state and UDim2.new(1, -8, 0.5, -3) or UDim2.new(0, 2, 0.5, -3)
        sendNotification(name .. ": " .. (state and "ON" or "OFF"))
        pcall(function() callback(state) end)
    end)
end

