            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.TextSize, pBtn.Font = 7, Enum.Font.GothamBold
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.Parent = playerScroll
            
            local pbc = Instance.new("UICorner")
            pbc.CornerRadius = UDim.new(0, 3)
            pbc.Parent = pBtn
            
            pBtn.MouseButton1Click:Connect(function()
                playClickSound()
                pcall(function()
                    local myChar = localPlayer.Character
                    if myChar and myChar:FindFirstChild("HumanoidRootPart") and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        myChar.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                        sendNotification("TP to " .. p.DisplayName)
                    end
                end)
            end)
            
            yPos = yPos + 20
        end
    end
    playerScroll.CanvasSize = UDim2.new(0, 0, 0, yPos)
end

