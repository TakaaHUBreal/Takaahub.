local pickupActive = false
createToggle(pageMain, "Auto Pickup Items", 24, function(enabled)
    pickupActive = enabled
end)

task.spawn(function()
    while true do
        task.wait(0.05)
        if pickupActive then
            pcall(function()
                local char = localPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                local root = char.HumanoidRootPart
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if not pickupActive then break end
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        local n = obj.Name:lower()
                        if n:match("item") or n:match("key") or n:match("tool") or n:match("pickup") or n:match("coin") or n:match("cash") then
                            local tpPart = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            if tpPart then
                                root.CFrame = tpPart.CFrame + Vector3.new(0, 2, 0)
                                task.wait(0.02)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

